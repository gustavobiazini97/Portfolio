# Apache (alwaysdata): ajustes para a API REST.
# Tudo está dentro de <IfModule>: se o mod_rewrite faltar, o site continua a funcionar.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # O PHP-FPM costuma esconder o cabeçalho Authorization; isto passa-o ao PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Link curto para instalar a app Android: /app → o APK mais recente (release do GitHub).
    # É o link que vai nos convites partilhados pela app.
    RewriteRule ^app/?$ https://github.com/gustavobiazini97/Portfolio/releases/download/anime-a-dois-apk/anime-a-dois.apk [R=302,L]

    # URLs bonitos: /api/series/naruto → api.php?rota=/series/naruto
    # (com ?rota= e não api.php/…: depois de um rewrite o alojamento não passa o PATH_INFO)
    RewriteRule ^api/(.*)$ api.php?rota=/$1 [QSA,L]
</IfModule>
